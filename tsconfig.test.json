{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/main.ts", "src/preload.ts", "src/renderer.ts"]
}
